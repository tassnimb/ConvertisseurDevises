<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ConvertisseurDevises.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   NavigationPage.HasNavigationBar="False"
    BackgroundColor="#0B1420">

    <Grid RowDefinitions="Auto,*"
          Padding="20"
          RowSpacing="18">

        <!-- ================= EN-TÊTE ================= -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8">
            <Button
    Text="← Retour"
    HorizontalOptions="Start"
    BackgroundColor="#142438"
    TextColor="#D6AD62"
    BorderColor="#26394D"
    BorderWidth="1"
    CornerRadius="10"
    Padding="15,8"
    Clicked="Back_Clicked"/>

            <Label Text="HISTORIQUE"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#D6AD62"/>

           

            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,12,0,0">

                <Label Text="Mes conversions"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#F5F7FA"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1"
                        Text="Tout effacer"
                        Clicked="ClearHistory_Clicked"
                        BackgroundColor="#40232B"
                        TextColor="#FF9999"
                        CornerRadius="10"
                        FontSize="12"
                        Padding="12,8"/>

            </Grid>

            <BoxView HeightRequest="1"
                     Color="#26394D"
                     Margin="0,5,0,0"/>

        </VerticalStackLayout>

        <!-- ================= LISTE DES CONVERSIONS ================= -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">

            <!-- Liste vide -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="20">

                    <Label Text="↗"
                           FontSize="48"
                           TextColor="#D6AD62"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Aucune conversion"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#F5F7FA"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Tes conversions apparaîtront ici."
                           FontSize="14"
                           TextColor="#AFC5D9"
                           HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- Carte de conversion -->
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border BackgroundColor="#142438"
                            Stroke="#26394D"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <!-- DEVISES -->
                            <Grid ColumnDefinitions="*,Auto,*"
                                  ColumnSpacing="8">

                                <Label Grid.Column="0"
                                       Text="{Binding FromCurrency}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#D6AD62"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="→"
                                       FontSize="20"
                                       TextColor="#D6AD62"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="2"
                                       Text="{Binding ToCurrency}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#D6AD62"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"/>

                            </Grid>

                            <!-- MONTANTS -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="5">

                                    <Label Text="Montant initial"
                                           FontSize="12"
                                           TextColor="#AFC5D9"/>

                                    <Label Text="{Binding Amount, StringFormat='{0:N2}'}"
                                           FontSize="19"
                                           FontAttributes="Bold"
                                           TextColor="#F5F7FA"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="5">

                                    <Label Text="Résultat"
                                           FontSize="12"
                                           TextColor="#AFC5D9"
                                           HorizontalTextAlignment="End"/>

                                    <Label Text="{Binding ConvertedAmount, StringFormat='{0:N2}'}"
                                           FontSize="19"
                                           FontAttributes="Bold"
                                           TextColor="#D6AD62"
                                           HorizontalTextAlignment="End"/>

                                </VerticalStackLayout>

                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#26394D"/>

                            <!-- DATE ET SUPPRESSION -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">

                                <Label Grid.Column="0"
                                       Text="{Binding ConversionDate, StringFormat='{0:dd/MM/yyyy à HH:mm}'}"
                                       FontSize="12"
                                       TextColor="#AFC5D9"
                                       VerticalOptions="Center"/>

                                <Button Grid.Column="1"
                                        Text="Supprimer"
                                        FontSize="12"
                                        Padding="12,6"
                                        HeightRequest="34"
                                        BackgroundColor="#40232B"
                                        TextColor="#FF9999"
                                        CornerRadius="9"
                                        CommandParameter="{Binding .}"
                                        Clicked="Delete_Clicked"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
