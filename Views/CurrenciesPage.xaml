<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConvertisseurDevises.ViewModels"
             x:Class="ConvertisseurDevises.Views.CurrenciesPage"
             Title="Currencies"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource DisplayColor}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- EN-TÊTE -->
        <Grid Grid.Row="0"
              ColumnDefinitions="64,*,64"
              Padding="8,14">

            <Grid Grid.Column="0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Grid.GestureRecognizers>

                <Label Text="❮"
                       FontSize="26"
                       TextColor="{StaticResource BackArrowColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>

            <Label Grid.Column="1"
                   Text="Currencies"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextColor}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- RECHERCHE -->
        <Border Grid.Row="1"
                Margin="20,8,20,12"
                Padding="18,0"
                BackgroundColor="{StaticResource SearchBgColor}"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>

            <Entry Placeholder="Search"
                   Text="{Binding SearchText}"
                   PlaceholderColor="{StaticResource MutedColor}"
                   TextColor="{StaticResource TextColor}"
                   BackgroundColor="Transparent"
                   FontSize="22"
                   HeightRequest="52" />
        </Border>

        <!-- LISTE DES DEVISES -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0">

                <!-- SECTION FAVORIS -->
                <Label Text="⭐ FAVORIS"
               IsVisible="{Binding HasFavorites}"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#F5B82E"
               Margin="20,18,20,8" />

                <CollectionView ItemsSource="{Binding FavoriteCurrencies}"
                        SelectionMode="None"
                        HeightRequest="Auto">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="14"
                          Padding="20,0"
                          HeightRequest="76">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrenciesViewModel}}, Path=SelectCommand}"
                                CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center"
                                StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding FlagUrl}" />
                                </Border>

                                <Label Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource TextColor}" />

                                <Label Grid.Column="2"
                               Text="{Binding Code}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource FavoriteCodeColor}" />

                                <Label Grid.Column="3"
                               Text="★"
                               FontSize="27"
                               TextColor="#F5B82E"
                               VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrenciesViewModel}}, Path=FavoriteCommand}"
                                    CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- SECTION AUTRES DEVISES -->
                <Label Text="TOUTES LES DEVISES"
               IsVisible="{Binding HasOtherCurrencies}"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="{StaticResource MutedColor}"
               Margin="20,18,20,8" />

                <CollectionView ItemsSource="{Binding OtherCurrencies}"
                        SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="14"
                          Padding="20,0"
                          HeightRequest="76">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrenciesViewModel}}, Path=SelectCommand}"
                                CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center"
                                StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding FlagUrl}" />
                                </Border>

                                <Label Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource TextColor}" />

                                <Label Grid.Column="2"
                               Text="{Binding Code}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource MutedColor}" />

                                <Label Grid.Column="3"
                               Text="☆"
                               FontSize="27"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrenciesViewModel}}, Path=FavoriteCommand}"
                                    CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
