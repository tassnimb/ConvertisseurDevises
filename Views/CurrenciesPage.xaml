<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConvertisseurDevises.ViewModels"
             x:Class="ConvertisseurDevises.Views.CurrenciesPage"
             Title="Currencies"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource DisplayColor}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ================= EN-TÊTE : flèche retour + titre ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="64,*,64" Padding="8,14">
            <Grid Grid.Column="0" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Grid.GestureRecognizers>
                <Label Text="❮"
                       FontSize="26"
                       TextColor="{StaticResource BackArrowColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>

            <Label Grid.Column="1"
                   Text="Currencies"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextColor}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ================= BARRE DE RECHERCHE ================= -->
        <Border Grid.Row="1"
                Margin="20,8,20,12"
                Padding="18,0"
                BackgroundColor="{StaticResource SearchBgColor}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>
            <Entry Placeholder="Search"
                   Text="{Binding SearchText}"
                   PlaceholderColor="{StaticResource MutedColor}"
                   TextColor="{StaticResource TextColor}"
                   BackgroundColor="Transparent"
                   FontSize="22"
                   HeightRequest="52" />
        </Border>

        <!-- ================= LISTE DES DEVISES ================= -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredCurrencies}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="18"
                          Padding="20,0"
                          HeightRequest="76"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrenciesViewModel}}, Path=SelectCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- Drapeau rond -->
                        <Border Grid.Column="0"
                                WidthRequest="46" HeightRequest="46"
                                VerticalOptions="Center"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource KeyFuncColor}">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Image Source="{Binding FlagUrl}" Aspect="AspectFill" />
                        </Border>

                        <!-- Nom -->
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="22"
                               TextColor="{StaticResource TextColor}"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />

                        <!-- Code : gris, jaune si favori -->
                        <Label Grid.Column="2"
                               Text="{Binding Code}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedColor}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource FavoriteCodeColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>