<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConvertisseurDevises.Views.MainPage"
             Title="ConvertisseurDevises"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="#0B1420">

    <ContentPage.Resources>

        <!-- Boutons numériques -->
        <Style x:Key="KeyDigit" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#17283B"/>
            <Setter Property="TextColor" Value="#F5F7FA"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Boutons fonctionnels -->
        <Style x:Key="KeyFunc" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#24394E"/>
            <Setter Property="TextColor" Value="#D6AD62"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Boutons opérateurs -->
        <Style x:Key="KeyOp" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#D6AD62"/>
            <Setter Property="TextColor" Value="#102033"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,1.15*,1.15*,5*,Auto"
          RowSpacing="0">

        <!-- ================= EN-TÊTE ================= -->
        <Grid Grid.Row="0"
              Padding="22,14"
              ColumnDefinitions="*,Auto"
              BackgroundColor="#10243A">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="3"
                                 VerticalOptions="Center">

                <Label Text="CURRENCY"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="#D6AD62"/>

                <Label Text="Convertisseur de devises"
                       FontSize="12"
                       TextColor="#AFC5D9"/>
            </VerticalStackLayout>

            <!-- Déconnexion -->
            <Button Grid.Column="1"
                    Text="⏻"
                    FontSize="23"
                    TextColor="#D6AD62"
                    BackgroundColor="#24394E"
                    CornerRadius="25"
                    WidthRequest="48"
                    HeightRequest="48"
                    Clicked="Logout_Clicked"
                    VerticalOptions="Center"/>

        </Grid>

        <!-- ================= DEVISE DU HAUT ================= -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              Padding="22,10"
              BackgroundColor="#0F1D2C">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectRowCommand}"
                                      CommandParameter="0"/>
            </Grid.GestureRecognizers>

            <VerticalStackLayout Grid.Column="0"
                                 VerticalOptions="Center"
                                 Spacing="7"
                                 MinimumWidthRequest="85">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickCurrencyCommand}"
                                          CommandParameter="0"/>
                </VerticalStackLayout.GestureRecognizers>

                <Border WidthRequest="46"
                        HeightRequest="46"
                        Stroke="#D6AD62"
                        StrokeThickness="2"
                        BackgroundColor="#24394E"
                        HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <Ellipse/>
                    </Border.StrokeShape>

                    <Image Source="{Binding TopCurrency.FlagUrl}"
                           Aspect="AspectFill"/>
                </Border>

                <Label Text="{Binding TopCurrency.Code}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#D6AD62"/>
            </VerticalStackLayout>

            <Label Grid.Column="1"
                   Text="{Binding TopText}"
                   FontSize="{Binding TopFontSize}"
                   FontAttributes="Bold"
                   TextColor="#F5F7FA"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center"
                   LineBreakMode="NoWrap"/>

            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="1"
                     VerticalOptions="End"
                     Color="#26394D"/>

        </Grid>

        <!-- ================= DEVISE DU BAS ================= -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              Padding="22,10"
              BackgroundColor="#142438">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectRowCommand}"
                                      CommandParameter="1"/>
            </Grid.GestureRecognizers>

            <VerticalStackLayout Grid.Column="0"
                                 VerticalOptions="Center"
                                 Spacing="7"
                                 MinimumWidthRequest="85">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickCurrencyCommand}"
                                          CommandParameter="1"/>
                </VerticalStackLayout.GestureRecognizers>

                <Border WidthRequest="46"
                        HeightRequest="46"
                        Stroke="#D6AD62"
                        StrokeThickness="2"
                        BackgroundColor="#24394E"
                        HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <Ellipse/>
                    </Border.StrokeShape>

                    <Image Source="{Binding BottomCurrency.FlagUrl}"
                           Aspect="AspectFill"/>
                </Border>

                <Label Text="{Binding BottomCurrency.Code}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#D6AD62"/>
            </VerticalStackLayout>

            <Label Grid.Column="1"
                   Text="{Binding BottomText}"
                   FontSize="{Binding BottomFontSize}"
                   FontAttributes="Bold"
                   TextColor="#D6AD62"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center"
                   LineBreakMode="NoWrap"/>

        </Grid>

        <!-- ================= MESSAGE D'ERREUR ================= -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                IsVisible="{Binding HasError}"
                VerticalOptions="Start"
                Margin="16,8"
                Padding="12"
                BackgroundColor="#40232B"
                Stroke="#E57373"
                StrokeThickness="1"
                ZIndex="2">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>

            <Label Text="{Binding ErrorMessage, StringFormat='⚠️  {0}'}"
                   TextColor="#FFFFFF"
                   FontSize="14"/>

        </Border>

        <!-- ================= CLAVIER ================= -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="*,*,*,*,*"
              ColumnSpacing="5"
              RowSpacing="5"
              Padding="10,10"
              BackgroundColor="#0B1420">

            <!-- Ligne 1 -->
            <Button Grid.Row="0" Grid.Column="0"
                    Text="C"
                    Style="{StaticResource KeyFunc}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="C"/>

            <Button Grid.Row="0" Grid.Column="1"
                    Text="←"
                    Style="{StaticResource KeyFunc}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="←"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Text="⇅"
                    Style="{StaticResource KeyFunc}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="⇅"/>

            <Button Grid.Row="0" Grid.Column="3"
                    Text="÷"
                    Style="{StaticResource KeyOp}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="÷"/>

            <!-- Ligne 2 -->
            <Button Grid.Row="1" Grid.Column="0"
                    Text="7"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="7"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Text="8"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="8"/>

            <Button Grid.Row="1" Grid.Column="2"
                    Text="9"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="9"/>

            <Button Grid.Row="1" Grid.Column="3"
                    Text="×"
                    Style="{StaticResource KeyOp}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="×"/>

            <!-- Ligne 3 -->
            <Button Grid.Row="2" Grid.Column="0"
                    Text="4"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="4"/>

            <Button Grid.Row="2" Grid.Column="1"
                    Text="5"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="5"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Text="6"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="6"/>

            <Button Grid.Row="2" Grid.Column="3"
                    Text="−"
                    Style="{StaticResource KeyOp}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="−"/>

            <!-- Ligne 4 -->
            <Button Grid.Row="3" Grid.Column="0"
                    Text="1"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="1"/>

            <Button Grid.Row="3" Grid.Column="1"
                    Text="2"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="2"/>

            <Button Grid.Row="3" Grid.Column="2"
                    Text="3"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="3"/>

            <Button Grid.Row="3" Grid.Column="3"
                    Text="+"
                    Style="{StaticResource KeyOp}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="+"/>

            <!-- Ligne 5 -->
            <Button Grid.Row="4" Grid.Column="0"
                    Text="%"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="%"/>

            <Button Grid.Row="4" Grid.Column="1"
                    Text="0"
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="0"/>

            <Button Grid.Row="4" Grid.Column="2"
                    Text=","
                    Style="{StaticResource KeyDigit}"
                    Command="{Binding KeyCommand}"
                    CommandParameter=","/>

            <Button Grid.Row="4" Grid.Column="3"
                    Text="="
                    Style="{StaticResource KeyOp}"
                    Command="{Binding KeyCommand}"
                    CommandParameter="="/>

        </Grid>

        <!-- ================= BARRE DU BAS ================= -->
        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,*,Auto,Auto"
              Padding="20,12,20,8"
              ColumnSpacing="12"
              BackgroundColor="#10243A">

            <!-- Actualiser -->
            <Label Grid.Column="0"
                   Text="↻"
                   FontSize="32"
                   TextColor="#D6AD62"
                   VerticalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                </Label.GestureRecognizers>

            </Label>

            <!-- Informations des taux -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">

                <Label Text="{Binding RateText}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#F5F7FA"
                       HorizontalTextAlignment="Center"/>

                <Label Text="{Binding UpdatedText}"
                       FontSize="11"
                       TextColor="{Binding UpdatedColor}"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <!-- Historique -->
            <Border Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Stroke="#D6AD62"
                    StrokeThickness="1.5"
                    BackgroundColor="#24394E">

                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="History_Tapped"/>
                </Border.GestureRecognizers>

                <Label Text="◷"
                       FontSize="26"
                       TextColor="#D6AD62"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

            </Border>

            <!-- Informations -->
            <Border Grid.Column="3"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Stroke="#D6AD62"
                    StrokeThickness="1.5"
                    BackgroundColor="#24394E">

                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding InfoCommand}"/>
                </Border.GestureRecognizers>

                <Label Text="⋮"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#D6AD62"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

            </Border>

        </Grid>

    </Grid>
</ContentPage>
